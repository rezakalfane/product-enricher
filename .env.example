# ---- BigCommerce: store "flawless" (Flawless Demo) ----
BIGCOMMERCE_STORE_HASH=ufbonfrcnz
BIGCOMMERCE_ACCESS_TOKEN=
BIGCOMMERCE_API_URL=https://api.bigcommerce.com
# Channel: "Flawless Vape UK Distribution"
BIGCOMMERCE_CHANNEL_ID=1
BIGCOMMERCE_CHANNEL_NAME="Flawless Vape UK Distribution"

# ---- AI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
# Vision model used for product-image identification (must support image input)
OPENAI_VISION_MODEL=gpt-5.6-luna

# ---- Storage ----
# Local dev: a SQLite file and a local upload directory.
DATABASE_PATH=./data/enricher.db
UPLOAD_DIR=./data/uploads

# Deployed: set these and the two above are ignored.
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=
# BLOB_READ_WRITE_TOKEN=

# ---- Channel ingest (optional, see docs/CHANNELS.md) ----
# Shared secret for /api/ingest and the reply callback. Ingest is disabled while unset.
# INGEST_SECRET=
# Pipedream HTTP trigger that posts replies back to the channel.
# PIPEDREAM_REPLY_URL=
# Review link included in replies.
# APP_PUBLIC_URL=http://localhost:3210
